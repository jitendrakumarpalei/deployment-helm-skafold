{
  "name": "stringcost",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "vendor/portkey-gateway"
  ],
  "scripts": {
    "deploy:build": "npm run build",
    "deploy:start": "npx pm2-runtime deploy/ecosystem.config.cjs",
    "gae:start": "npm run build && npx pm2-runtime deploy/ecosystem.config.cjs",
    "gae:deploy": "bash deploy/appengine/deploy.sh",
    "gae:clean": "node deploy/appengine/clean.mjs",
    "gae:start:gateway": "node apps/gateway/dist/server.js",
    "gae:start:control-plane": "node apps/control-plane/dist/index.js",
    "gae:start:event-collector": "node apps/event-collector/dist/index.js",
    "gae:start:worker": "node apps/worker/dist/server.js",
    "build": "npm -ws run build",
    "test": "npm -ws run test",
    "test:ledger": "npm run test --workspace @stringcost/ledger",
    "migrate": "npm run migrate --workspace @stringcost/ledger",
    "migrate:control-plane": "tsx ./node_modules/knex/bin/cli.js --knexfile apps/control-plane/knexfile.ts migrate:latest",
    "migrate:ledger": "tsx ./node_modules/knex/bin/cli.js --knexfile apps/ledger/knexfile.ts migrate:latest",
    "seed:control-plane": "tsx ./node_modules/knex/bin/cli.js --knexfile apps/control-plane/knexfile.ts seed:run",
    "seed:ledger": "tsx ./node_modules/knex/bin/cli.js --knexfile apps/ledger/knexfile.ts seed:run",
    "db:migrate": "npm run migrate:control-plane && npm run migrate:ledger",
    "db:seed": "npm run seed:control-plane && npm run seed:ledger"
  },
  "devDependencies": {
    "langchain": "^0.2.16",
    "openai": "^4.52.0",
    "supertest": "^7.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "knex": "^3.1.0",
    "pg": "^8.16.3"
  }
}
