{
  "name": "stringcost",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "vendor/portkey-gateway"
  ],
  "scripts": {
    "deploy:build": "npm run build",
    "deploy:start": "npx pm2-runtime deploy/ecosystem.config.cjs",
    "gae:start": "npm run build && npx pm2-runtime deploy/ecosystem.config.cjs",
    "gae:deploy": "bash deploy/appengine/deploy.sh",
    "build": "npm -ws run build",
    "test": "npm -ws run test",
    "test:ledger": "npm run test --workspace @stringcost/ledger",
    "migrate": "npm run migrate --workspace @stringcost/ledger"
  },
  "devDependencies": {
    "langchain": "^0.2.16",
    "openai": "^4.52.0",
    "typescript": "5.6.3"
  }
}
