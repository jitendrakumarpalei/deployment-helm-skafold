{
  "name": "stringcost",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "vendor/portkey-gateway"
  ],
  "scripts": {
    "deploy:build": "npm run build",
    "deploy:start": "npx pm2-runtime deploy/ecosystem.config.cjs",
    "gae:start": "npm run build && npx pm2-runtime deploy/ecosystem.config.cjs",
    "gae:deploy": "bash deploy/appengine/deploy.sh",
    "gae:clean": "node deploy/appengine/clean.mjs",
    "gae:start:gateway": "npm run build --workspace @stringcost/gateway && node apps/gateway/dist/server.js",
    "gae:start:control-plane": "npm run build --workspace @stringcost/control-plane && node apps/control-plane/dist/index.js",
    "gae:start:event-collector": "npm run build --workspace @stringcost/event-collector && node apps/event-collector/dist/index.js",
    "gae:start:worker": "npm run build --workspace @stringcost/worker && node apps/worker/dist/server.js",
    "build": "npm -ws run build",
    "test": "npm -ws run test",
    "test:ledger": "npm run test --workspace @stringcost/ledger",
    "migrate": "npm run migrate --workspace @stringcost/ledger"
  },
  "devDependencies": {
    "langchain": "^0.2.16",
    "openai": "^4.52.0",
    "typescript": "5.6.3"
  }
}
